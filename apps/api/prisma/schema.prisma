generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
  SUPER_ADMIN
}

enum AuthProvider {
  EMAIL
  GOOGLE
}

enum TransactionType {
  INCOME
  EXPENSE
  TRANSFER
  LOAN_PAYMENT
}

enum LoanStatus {
  ACTIVE
  PAID
  DEFAULTED
}

enum SubscriptionStatus {
  TRIALING
  ACTIVE
  PAST_DUE
  CANCELED
  EXPIRED
}

enum BillingCycle {
  MONTHLY
  YEARLY
}

enum ChatRole {
  USER
  ASSISTANT
  SYSTEM
}

model User {
  id                 String          @id @default(cuid())
  name               String
  email              String          @unique
  passwordHash       String?
  avatarUrl          String?
  provider           AuthProvider    @default(EMAIL)
  googleId           String?         @unique
  role               Role            @default(USER)
  currency           String          @default("INR")
  emailVerifiedAt    DateTime?
  resetTokenHash     String?
  resetTokenExpires  DateTime?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  expenses           Expense[]
  loans              Loan[]
  transactions       Transaction[]
  aiChats            AiChat[]
  subscriptions      Subscription[]
  savingsGoals       SavingsGoal[]
  adminProfile       AdminProfile?
  administeredEvents AdminAuditLog[] @relation("AdminActor")
}

model AdminProfile {
  id          String   @id @default(cuid())
  userId      String   @unique
  department  String   @default("Operations")
  permissions Json     @default("[\"users:read\",\"subscriptions:read\",\"analytics:read\"]")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Expense {
  id          String   @id @default(cuid())
  userId      String
  title       String
  amount      Decimal  @db.Decimal(12, 2)
  category    String
  merchant    String?
  notes       String?
  spentAt     DateTime
  aiCategory  String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  user        User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, spentAt])
  @@index([userId, category])
}

model Loan {
  id             String     @id @default(cuid())
  userId         String
  lenderName     String
  principal      Decimal    @db.Decimal(12, 2)
  interestRate   Decimal    @db.Decimal(5, 2)
  tenureMonths   Int
  emiAmount      Decimal    @db.Decimal(12, 2)
  outstanding    Decimal    @db.Decimal(12, 2)
  startDate      DateTime
  nextPaymentDue DateTime?
  status         LoanStatus @default(ACTIVE)
  notes          String?
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  user           User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments       LoanPayment[]

  @@index([userId, status])
}

model LoanPayment {
  id        String   @id @default(cuid())
  loanId    String
  amount    Decimal  @db.Decimal(12, 2)
  paidAt    DateTime
  note      String?
  createdAt DateTime @default(now())
  loan      Loan     @relation(fields: [loanId], references: [id], onDelete: Cascade)
}

model Transaction {
  id          String          @id @default(cuid())
  userId      String
  type        TransactionType
  title       String
  amount      Decimal         @db.Decimal(12, 2)
  category    String?
  occurredAt  DateTime
  referenceId String?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  user        User            @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, occurredAt])
}

model SavingsGoal {
  id            String   @id @default(cuid())
  userId        String
  name          String
  targetAmount  Decimal  @db.Decimal(12, 2)
  currentAmount Decimal  @db.Decimal(12, 2) @default(0)
  targetDate    DateTime?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  user          User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AiChat {
  id        String      @id @default(cuid())
  userId    String
  title     String
  createdAt DateTime    @default(now())
  updatedAt DateTime    @updatedAt
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  messages  AiMessage[]
}

model AiMessage {
  id        String   @id @default(cuid())
  chatId    String
  role      ChatRole
  content   String
  metadata  Json?
  createdAt DateTime @default(now())
  chat      AiChat   @relation(fields: [chatId], references: [id], onDelete: Cascade)
}

model Subscription {
  id                     String             @id @default(cuid())
  userId                 String
  plan                   String
  status                 SubscriptionStatus @default(TRIALING)
  billingCycle           BillingCycle       @default(MONTHLY)
  razorpayCustomerId     String?
  razorpaySubscriptionId String?            @unique
  currentPeriodStart     DateTime?
  currentPeriodEnd       DateTime?
  createdAt              DateTime           @default(now())
  updatedAt              DateTime           @updatedAt
  user                   User               @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, status])
}

model AdminAuditLog {
  id        String   @id @default(cuid())
  actorId   String
  action    String
  entity    String
  entityId  String?
  metadata  Json?
  createdAt DateTime @default(now())
  actor     User     @relation("AdminActor", fields: [actorId], references: [id], onDelete: Cascade)
}
